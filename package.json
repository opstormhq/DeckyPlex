{
  "name": "deckyplex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "clean": "rm -rf dist DeckyPlex.zip",
    "package": "npm run build && bash scripts/package.sh"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@playwright/test": "^1.65.1",
    "@types/react": "19.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.11.0",
    "hls.js": "1.7.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
